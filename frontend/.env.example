# Zmienne frontendu (Next.js), wszystkie opcjonalne lokalnie. Skopiuj do frontend/.env.local.
# Na Vercelu ustaw je w ustawieniach projektu.

# === SEO / Deployment ===
# Pełny URL produkcyjny (bez ukośnika na końcu). Używany dla canonical, OG, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://cv-finder.example.com

# Kod weryfikacyjny z Google Search Console (https://search.google.com/search-console)
# Wartość z meta tagu <meta name="google-site-verification" content="..." />
# Opcjonalne - zostaw puste jeśli weryfikujesz przez DNS / plik HTML.
GOOGLE_SITE_VERIFICATION=

# === Analytics (opcjonalnie) ===
# Google Analytics 4 measurement ID (np. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
